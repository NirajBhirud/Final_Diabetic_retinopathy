# ── RetinaAI Backend — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Inference Mode ────────────────────────────────────────────────────────────
# "DIRECT_TF"   → loads saved model directly (easier for local dev)
# "TF_SERVING"  → calls your running Docker TF Serving endpoint
INFERENCE_MODE=DIRECT_TF

# ── Direct TF Mode ────────────────────────────────────────────────────────────
# Path to your exported SavedModel directory
# Run: python src/export.py --model_dir saved_models/latest --export_dir exported_model/1
SAVED_MODEL_PATH=exported_model/1

# ── TF Serving Mode ───────────────────────────────────────────────────────────
# URL of your TF Serving Docker container
TF_SERVING_URL=http://localhost:8501/v1/models/retinopathy:predict
TF_SERVING_TIMEOUT=10

# ── Flask ─────────────────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=false
